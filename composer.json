{
    "name": "kunstverwaltung/app",
    "description": "Verwaltung von Kunstwerken mit Gruppen, Export- und Backup-Funktionen",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-zip": "*",
        "ext-gd": "*",
        "dompdf/dompdf": "^3.1",
        "phpoffice/phpspreadsheet": "^5.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": false
    }
}
